{
  "name": "@the-ants/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005 -H 127.0.0.1 --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cf:build": "cross-env NEXT_PUBLIC_API_URL=https://api.the-ants.org NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=TheANTS_bot opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@the-ants/db": "*",
    "@the-ants/shared-types": "*",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/react-katex": "^3.0.4",
    "better-auth": "^1.7.1",
    "dompurify": "^3.4.11",
    "katex": "^0.17.0",
    "lucide-react": "^1.18.0",
    "mermaid": "^11.16.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-katex": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.131.1"
  }
}
