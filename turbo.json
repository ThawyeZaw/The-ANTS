{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "TELEGRAM_BOT_TOKEN",
    "NEXT_PUBLIC_TELEGRAM_BOT_USERNAME",
    "CRON_SECRET",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_API_URL",
    "CLOUDFLARE_API_TOKEN",
    "R2_PUBLIC_BASE_URL",
    "ENVIRONMENT",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
