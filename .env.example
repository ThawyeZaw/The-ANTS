# ── The ANTS — Required Environment Variables ─────────────────────────────────
# Copy to .env.local / apps/web/.dev.vars / apps/api/.dev.vars as needed.
# Migration tracker: docs/migration/cloudflare.md (Phase 4 = URL align / Neon leftovers)

# ── Cloudflare D1 (live DB for Workers — Phase 3+) ────────────────────────────
# Created via: npx wrangler d1 create the-ants-db
# Bind as `DB` in apps/api/wrangler.jsonc and apps/web/wrangler.jsonc
# Database id (the-ants-db): d30062da-47f0-448a-b89b-c8c067981b28
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=d30062da-47f0-448a-b89b-c8c067981b28

# ── Neon (offline archive only — do NOT use as Workers DB) ────────────────────
# Keep the Neon project until Phase 6 full cutover / data decision.
# Phase 5 may use this for export → D1 import. Not read by Workers runtime.
# DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# ── Hono API Backend (Cloudflare Worker) ──────────────────────────────────────
# Canonical production + CF web preview build target:
NEXT_PUBLIC_API_URL=https://api.the-ants.org
# Local API (wrangler / npm run dev:api):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# ── Better Auth (API Worker) ──────────────────────────────────────────────────
# BETTER_AUTH_SECRET=   # preferred; falls back to CRON_SECRET if unset
# BETTER_AUTH_URL=https://api.the-ants.org   # optional; code defaults to this when not local

# ── R2 (bucket the-ants-assets via ASSETS_BUCKET binding — keep as-is) ────────
# Private bucket; files served by API at /api/storage/file/...
# Optional stable public origin (defaults to https://api.the-ants.org when deployed):
# R2_PUBLIC_BASE_URL=https://api.the-ants.org

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=TheANTS_bot

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=

# Removed from Workers: QSTASH_*, SUPABASE_*, Neon createDb(url) / DATABASE_URL binding
