# ── The ANTS — Required Environment Variables (HONC Stack) ──────────────────────
# Copy this file to .env.local and fill in the values.

# ── Neon Postgres Database ───────────────────────────────────────────────────
# Pooled or direct connection string from Neon dashboard
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# ── Hono API Backend (Cloudflare Worker) ──────────────────────────────────────
# Local dev: http://127.0.0.1:8787 | Production: https://the-ants-api.<subdomain>.workers.dev
NEXT_PUBLIC_API_URL=https://the-ants-api.thawyezaw.workers.dev

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Bot username (without @)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=TheANTS_bot

# ── Cron / Scheduled Tasks ──────────────────────────────────────────────────
# Secret for cron job authentication
CRON_SECRET=
